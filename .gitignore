.env
.env.*
!.env.example
node_modules/
# Build outputs are committed on purpose: the Docker image ships dist/ and downloads/ so the
# landing page's /app-setup.exe and /app-debug.apk routes work on the hosted site.
android/.gradle/
android/build/
android/local.properties
android/app/build/
android/app/src/main/assets/
android/app/src/main/res/drawable-nodpi/novacore_icon.png
android/.signing/
downloads/NovaCore-Android.apk
# Generated by electron-builder on every desktop build; a leftover from an older release is a
# stale binary that must not ship.
dist/NovaCore Setup 1.0.0.exe
dist/NovaCore Setup 1.0.0.exe.blockmap
# The deploy-gate/ verification scripts are committed; only their local build output is ignored.
deploy-gate/*.log

# Commit message scratch file, never part of the repository.
.commit-message.txt
