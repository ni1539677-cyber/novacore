# NovaCore server configuration for public hosting.
# Copy to .env (never commit it), or set the same names in your host's dashboard.
# server.js reads .env on startup for any variable that is not already set, so real hosting
# environment variables always win and a deployed container needs no .env at all.

# Address to bind. localhost (default) = this device only. Use 0.0.0.0 to let a tunnel,
# reverse proxy, or other devices on the network reach the server.
HOST=0.0.0.0

# Port to listen on. Most hosts inject PORT; override only when running manually.
PORT=3000

# Your public URL, e.g. https://novacore.onrender.com or https://abc-123.trycloudflare.com.
# Optional: it only changes what startup prints. The server already trusts the request's own
# Host header for same-origin requests, so any domain works without listing it here.
# NOVACORE_PUBLIC_URL=https://your-app.example.com

# Comma-separated extra origins allowed to call /api/search and /api/gemini.
# Only needed for callers on a DIFFERENT origin than this server:
#   https://my-site.example.com   a page you host elsewhere
#   null                          the packaged .exe / .apk (file:// pages send Origin: null)
# The hosted page served by this same server needs no entry.
# NOVACORE_PUBLIC_ORIGIN=null

# Behind Render/Fly/Railway/Vercel or any reverse proxy, keep this "true" so
# rate limits are per client instead of per proxy.
NOVACORE_TRUST_PROXY=true

# Optional: a server-side Gemini key so end users never need their own.
# Leave unset to keep the "each user brings their own key" model.
# NOVACORE_GEMINI_API_KEY=
